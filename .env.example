# Copy this file to .env and adjust as needed.
# Every value below is read via django-environ in mob_delivery/settings.py —
# grep that file for a var name if you need to see exactly how it's used.

SECRET_KEY=django-insecure-+3**=722jistbzi9z(*t=d4#8$e)pga50qns4p!kg!=5(aqs&d
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (started via `docker compose up -d db`)
DATABASE_URL=postgres://mob:mob@localhost:5432/mob_delivery

# Redis — one instance, three roles, three DB indices (see README's "Redis"
# section for the full breakdown of why these must stay separate).
REDIS_URL=redis://localhost:6379/1
CHANNEL_LAYER_REDIS_URL=redis://localhost:6379/2
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# JWT — SIGNING_KEY falls back to SECRET_KEY if unset; set an independent
# min-32-char random value in production so rotating one doesn't rotate the other.
JWT_SIGNING_KEY=
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7
API_CLIENT_TOKEN_LIFETIME_MINUTES=60
DRIVER_TOKEN_LIFETIME_MINUTES=60
DRIVER_REFRESH_TOKEN_LIFETIME_DAYS=30

# Non-prod only: returns the generated OTP in the otp/request response body
# so the driver login flow is testable without a real SMS gateway.
DRIVER_OTP_DEBUG_RESPONSE=True

# API rate limiting (Fix 6) — applies to ApiClient-authenticated requests only;
# AdminUser/Driver requests are never throttled. See accounts/throttling.py.
API_CLIENT_RATE_LIMIT=100/min

# Anomaly detection — global knob not overridden per-tenant (the radius/duration/
# angle thresholds ARE per-tenant, via TenantSetting — see tenant_settings app).
ANOMALY_WRONG_DIRECTION_MIN_CONSECUTIVE_PINGS=3

# TripLocationPing data retention (Fix 7) — weekly purge, see
# tracking.tasks.purge_old_location_pings / CELERY_BEAT_SCHEDULE.
LOCATION_PING_RETENTION_DAYS=90

# CORS — the Admin Panel's origin(s). Comma-separated if more than one
# (e.g. staging + production). Never set CORS_ALLOW_ALL_ORIGINS=True.
ALLOWED_ADMIN_PANEL_ORIGIN=https://admin.example.com

# Azure Blob Storage — leave unset to use local filesystem storage (MEDIA_ROOT) for dev.
# Fill these in to switch uploads to real Azure Blob with no code changes.
AZURE_ACCOUNT_NAME=
AZURE_ACCOUNT_KEY=
AZURE_CONTAINER=mob-uploads

# Uploads
MAX_UPLOAD_SIZE_MB=10

# Firebase Admin SDK (push notifications) — path to a service-account JSON
# file. Leave unset to disable push notifications (failures are swallowed,
# never block the triggering operation — see notifications/services.py).
# In production, write the secret JSON to this path from your secret store
# at deploy time; never commit the actual file.
FIREBASE_CREDENTIALS_PATH=

# Webhook signing secrets are generated per-ApiClient at onboarding
# (accounts.models.ApiClient.webhook_signing_secret) — there is no global
# webhook secret env var to set here. See webhooks/tasks.py for the HMAC
# scheme (HMAC-SHA256 over the raw request body).

# Company onboarding is done via a management command, not an HTTP endpoint —
# run `python manage.py bootstrap_company --company-name ... --admin-email ...
# --admin-password ...` from a machine/console with deploy access. There is no
# PLATFORM_MASTER_KEY: the access control boundary is server/CLI access itself.
