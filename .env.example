# Copy this file to .env and adjust as needed.

SECRET_KEY=django-insecure-+3**=722jistbzi9z(*t=d4#8$e)pga50qns4p!kg!=5(aqs&d
DEBUG=True
# The driver app reaches this server as 127.0.0.1 (iOS simulator), 10.0.2.2
# (Android emulator), or this machine's LAN address (a real phone) — add the
# one you use, or Django answers 400 DisallowedHost.
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# Exact browser origins allowed to call the API (also applies with DEBUG=False).
CORS_ALLOWED_ORIGINS=https://mob-driver.netlify.app

# Postgres (started via `docker compose up -d db`)
DATABASE_URL=postgres://mob:mob@localhost:5432/mob_delivery

# JWT
JWT_SIGNING_KEY=
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7
API_CLIENT_TOKEN_LIFETIME_MINUTES=60
DRIVER_TOKEN_LIFETIME_MINUTES=60
# How long a driver stays signed in without redoing the SMS OTP (the app renews
# its access token with a refresh token — see drivers/tokens.py).
DRIVER_REFRESH_TOKEN_LIFETIME_DAYS=30

# Non-prod only: returns the generated OTP in the otp/request response body
# so the driver login flow is testable without a real SMS gateway.
DRIVER_OTP_DEBUG_RESPONSE=True

# Redis (started via `docker compose up -d redis`) — OTP cache + Celery broker/backend.
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Azure Blob Storage — leave unset to use local filesystem storage (MEDIA_ROOT) for dev.
# Fill these in to switch uploads to real Azure Blob with no code changes.
AZURE_ACCOUNT_NAME=
AZURE_ACCOUNT_KEY=
AZURE_CONTAINER=mob-uploads

# Uploads
MAX_UPLOAD_SIZE_MB=10

# Valhalla (started via `docker compose up -d valhalla`) — routing engine
# used by trips.routing for distance/duration/polyline.
VALHALLA_URL=http://localhost:8002
VALHALLA_TIMEOUT_SECONDS=10

# trips.matching — max distance (km) from pickup for a driver to be
# considered for assignment.
DRIVER_MATCH_RADIUS_KM=8.0

# Kafka (started via `docker compose up -d kafka`) — trip lifecycle events.
# Leave disabled for local dev unless you're testing a downstream consumer;
# trip booking works fine with this off (see trips/events.py).
KAFKA_ENABLED=False
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TRIP_EVENTS_TOPIC=trip-events

# COD "scan to pay" QR (trips.payments) — VPA the QR is made out to. Stand-in
# until a real payment gateway (Razorpay/Cashfree/PhonePe) is chosen.
COMPANY_UPI_VPA=mob-delivery@upi
COMPANY_UPI_PAYEE_NAME=MOB Delivery

# Driver self sign-up: the company new phone numbers join. Blank = closed (only
# company-created drivers can log in), except with DEBUG=True where the only
# active company is used.
DRIVER_SIGNUP_COMPANY_ID=

# Share of a completed trip's fare credited to the driver's wallet.
DRIVER_EARNING_PERCENT=80

# Payments (COD "scan to pay" QR). razorpay = a single-use UPI QR created by
# Razorpay for each trip, confirmed by Razorpay (webhook / server-side check).
# upi_static = local-development stand-in only (nothing confirms the payment).
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Same value as in Razorpay Dashboard -> Webhooks (event: qr_code.credited); the
# webhook URL is https://<your-host>/api/v1/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_QR_VALID_MINUTES=30
# To develop without Razorpay keys, run `python scripts/dev_razorpay_stub.py` and set:
#   RAZORPAY_KEY_ID=rzp_test_stub  RAZORPAY_KEY_SECRET=stub_secret
#   RAZORPAY_WEBHOOK_SECRET=stub_webhook_secret  RAZORPAY_API_BASE=http://127.0.0.1:8003/v1

# Browser access (CORS) for a deployed Flutter WEB build. Exact origins, comma-separated:
# scheme + host (+ port), no path, no wildcard. Native iOS/Android apps don't need this.
# (While DEBUG is on, http://localhost:<any port> is allowed automatically for `flutter run -d chrome`.)
CORS_ALLOWED_ORIGINS=
