openapi: 3.0.3
info:
  title: MOB Delivery Backend API
  version: 1.0.0
  description: |-
    Multi-tenant delivery platform API, split below into three audiences by who calls each endpoint:

    - **Admin: \*** — the Admin Panel (fleet ops, dispatch, KYC, monitoring). Callers authenticate as an `AdminUser`.
    - **Driver: \*** — the driver mobile app. Callers authenticate as a `Driver` via phone+OTP login.
    - **Integrations: \*** — 3rd-party/partner backends (order intake, order status). Callers authenticate as an `ApiClient` via client-credentials.

    A handful of endpoints are legitimately used by two audiences (e.g. token refresh, file upload) — those appear under both of their tags rather than being force-fit into one.
paths:
  /api/v1/admin/users:
    get:
      operationId: admin_users_list
      description: Lists every AdminUser (sub-user) in the caller's own company, newest
        first.
      summary: List admin users
      parameters:
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      tags:
      - 'Admin: Users'
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedAdminUserList'
          description: ''
    post:
      operationId: admin_users_create
      description: Creates another AdminUser under the caller's own company — the
        company is always taken from the authenticated caller, never from the request
        body, so it can't be spoofed to create a user in a different company. Every
        sub-user gets the same full access within their company; there are no roles/permission
        tiers in this pass.
      summary: Create a sub-user
      tags:
      - 'Admin: Users'
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AdminUser'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AdminUser'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AdminUser'
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AdminUser'
          description: ''
  /api/v1/admin/users/{id}/disable:
    post:
      operationId: admin_users_disable_create
      description: Soft-deletes and deactivates another AdminUser in the caller's
        own company — their existing JWTs stop working immediately. An admin cannot
        disable their own account (409 `CANNOT_DISABLE_SELF`), and an id belonging
        to a different company 404s rather than leaking its existence.
      summary: Disable a sub-user
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - 'Admin: Users'
      responses:
        '200':
          description: No response body
  /api/v1/alerts:
    get:
      operationId: alerts_list
      description: Lists automated anomaly alerts (a vehicle stationary too long,
        or heading the wrong direction) raised by the tracking Celery Beat jobs for
        in-transit trips. Filterable by `alert_type` and `acknowledged`.
      summary: List anomaly alerts
      parameters:
      - in: query
        name: acknowledged
        schema:
          type: boolean
      - in: query
        name: alert_type
        schema:
          type: string
          enum:
          - stationary_too_long
          - wrong_direction
        description: |-
          * `stationary_too_long` - Stationary Too Long
          * `wrong_direction` - Wrong Direction
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      tags:
      - 'Admin: Tracking'
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedTripAnomalyAlertList'
          description: ''
  /api/v1/alerts/{id}/acknowledge:
    post:
      operationId: alerts_acknowledge_create
      description: Marks an alert acknowledged, clearing the way for a fresh alert
        of that type to be raised later if the anomaly recurs.
      summary: Acknowledge an alert
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        description: A UUID string identifying this trip anomaly alert.
        required: true
      tags:
      - 'Admin: Tracking'
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TripAnomalyAlert'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/TripAnomalyAlert'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/TripAnomalyAlert'
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TripAnomalyAlert'
          description: ''
  /api/v1/auth/client-token:
    post:
      operationId: auth_client_token_create
      description: 'Client-credentials style exchange: a partner integration''s `client_id`
        + `client_secret` (issued out-of-band by an admin) for a short-lived access
        token scoped to that client''s company. No refresh token is issued — the caller
        re-authenticates with the same credentials once the token expires.'
      summary: Get an ApiClient access token
      tags:
      - 'Integrations: Auth'
      security:
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/auth/login:
    post:
      operationId: auth_login_create
      description: Exchanges an AdminUser's email/password for an access + refresh
        JWT pair. Rejects disabled accounts (`is_active=False`) with a generic invalid-credentials
        error, same as a wrong password — it never reveals which part was wrong.
      summary: Admin login
      tags:
      - 'Admin: Auth'
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AdminTokenObtainPair'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AdminTokenObtainPair'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AdminTokenObtainPair'
        required: true
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AdminTokenObtainPair'
          description: ''
  /api/v1/auth/refresh:
    post:
      operationId: auth_refresh_create
      description: Exchanges a still-valid refresh token for a new access token. Works
        for any principal type whose refresh token was issued by this API — Admin
        (via login) or Driver (via OTP verify) — the token's own claims determine
        who it's reissued for. An invalid, malformed, or expired refresh token returns
        401.
      summary: Refresh an access token
      tags:
      - 'Admin: Auth'
      - 'Driver: Auth'
      security:
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/damage-reports:
    get:
      operationId: damage_reports_list
      description: Company-wide list of all vehicle damage reports, filterable by
        status/vehicle.
      summary: List damage reports
      parameters:
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - in: query
        name: severity
        schema:
          type: string
          enum:
          - high
          - low
          - medium
        description: |-
          * `low` - Low
          * `medium` - Medium
          * `high` - High
      - in: query
        name: status
        schema:
          type: string
          enum:
          - open
          - resolved
        description: |-
          * `open` - Open
          * `resolved` - Resolved
      - in: query
        name: vehicle_id
        schema:
          type: string
          format: uuid
      tags:
      - 'Admin: Damage Reports'
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedDamageReportListList'
          description: ''
  /api/v1/damage-reports/{id}:
    get:
      operationId: damage_reports_retrieve
      description: |-
        Scopes a ViewSet to the authenticated principal's company.

        Both AdminUser and ApiClient (see accounts.authentication) expose
        `.company`, so this works the same regardless of which one authenticated
        the request — no thread-locals, no default-manager magic.
      summary: Get a damage report
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        description: A UUID string identifying this vehicle damage report.
        required: true
      tags:
      - 'Admin: Damage Reports'
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/DamageReport'
          description: ''
  /api/v1/damage-reports/{id}/resolve:
    post:
      operationId: damage_reports_resolve_create
      description: 'Admin-only: marks a damage report resolved. A second resolve attempt
        on an already-resolved report is rejected.'
      summary: Resolve a damage report
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        description: A UUID string identifying this vehicle damage report.
        required: true
      tags:
      - 'Admin: Damage Reports'
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/DamageReport'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/DamageReport'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/DamageReport'
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/DamageReport'
          description: ''
  /api/v1/dashboard/fleet-status:
    get:
      operationId: dashboard_fleet_status_retrieve
      description: 'One row per active vehicle: assigned driver (if on a shift today),
        current trip, and a computed status — `moving` (recent GPS ping), `paused`
        (open TripPause), `idle_alert` (no recent ping or an unacknowledged stationary
        alert), or `offline` (no active shift). Also includes today''s working minutes
        so far and last known location.'
      summary: Get live fleet status
      tags:
      - 'Admin: Dashboard'
      responses:
        '200':
          description: No response body
  /api/v1/dashboard/kpis:
    get:
      operationId: dashboard_kpis_retrieve
      description: 'Company-wide summary counters for the Admin Panel home screen:
        vehicles active today, trips currently in transit, unacknowledged anomaly
        alerts, today''s average delivery duration, open damage reports, drivers locked
        for an expired DL, and documents expiring soon.'
      summary: Get dashboard KPIs
      tags:
      - 'Admin: Dashboard'
      responses:
        '200':
          description: No response body
  /api/v1/dashboard/recent-damage-reports:
    get:
      operationId: dashboard_recent_damage_reports_retrieve
      description: Most recently filed vehicle damage reports, newest first (default
        5, override with ?limit=).
      summary: Get recent damage reports
      tags:
      - 'Admin: Dashboard'
      responses:
        '200':
          description: No response body
  /api/v1/dashboard/recent-issues:
    get:
      operationId: dashboard_recent_issues_retrieve
      description: Most recently raised trip issues, newest first (default 5, override
        with ?limit=).
      summary: Get recent issues
      tags:
      - 'Admin: Dashboard'
      responses:
        '200':
          description: No response body
  /api/v1/driver/auth/otp/request:
    post:
      operationId: driver_auth_otp_request_create
      description: Sends a 6-digit OTP to the driver's registered phone number, valid
        for 5 minutes. Throttled to one request per 30 seconds per phone number (429
        if retried too soon). Rejected with 403 if the driver's account is locked
        (DL expired) or disabled. When `DRIVER_OTP_DEBUG_RESPONSE=True` (non-prod),
        the generated OTP is echoed back in the response so the flow is testable without
        a real SMS gateway.
      summary: Request a driver login OTP
      tags:
      - 'Driver: Auth'
      security:
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/driver/auth/otp/verify:
    post:
      operationId: driver_auth_otp_verify_create
      description: Verifies the OTP and, on success, logs the driver in — returns
        an access + refresh JWT pair. An invalid, wrong, or expired OTP returns 400
        `INVALID_OTP`. Re-checks the driver's account status too, in case it changed
        between request and verify.
      summary: Verify a driver login OTP
      tags:
      - 'Driver: Auth'
      security:
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/driver/devices/{token}:
    delete:
      operationId: driver_devices_destroy
      description: Removes one FCM token from the calling driver's registered devices
        — e.g. on logout.
      summary: Deregister a device from push notifications
      parameters:
      - in: path
        name: token
        schema:
          type: string
        required: true
      tags:
      - 'Driver: Devices'
      responses:
        '204':
          description: No response body
  /api/v1/driver/devices/register:
    post:
      operationId: driver_devices_register_create
      description: Registers (or upserts, if the FCM token already exists) a driver's
        device for push notifications. Driver-only.
      summary: Register a device for push notifications
      tags:
      - 'Driver: Devices'
      responses:
        '200':
          description: No response body
  /api/v1/driver/me:
    get:
      operationId: driver_me_retrieve
      description: Returns the authenticated driver's own profile and verification
        statuses. Driver-only — an AdminUser/ApiClient token is rejected.
      summary: Get the logged-in driver's own profile
      tags:
      - 'Driver: Profile'
      responses:
        '200':
          description: No response body
  /api/v1/drivers:
    get:
      operationId: drivers_list
      description: Lists this company's drivers, searchable by name/phone, filterable
        by verification/account status.
      summary: List drivers
      parameters:
      - in: query
        name: aadhar_status
        schema:
          type: string
          enum:
          - pending
          - rejected
          - verified
        description: |-
          * `pending` - Pending
          * `verified` - Verified
          * `rejected` - Rejected
      - in: query
        name: account_status
        schema:
          type: string
          enum:
          - active
          - disabled
          - locked_dl_expired
        description: |-
          * `active` - Active
          * `locked_dl_expired` - Locked — DL Expired
          * `disabled` - Disabled
      - in: query
        name: dl_status
        schema:
          type: string
          enum:
          - pending
          - rejected
          - verified
        description: |-
          * `pending` - Pending
          * `verified` - Verified
          * `rejected` - Rejected
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - in: query
        name: police_status
        schema:
          type: string
          enum:
          - pending
          - rejected
          - verified
        description: |-
          * `pending` - Pending
          * `verified` - Verified
          * `rejected` - Rejected
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      tags:
      - 'Admin: Drivers'
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedDriverListList'
          description: ''
    post:
      operationId: drivers_create
      description: 'Creates a driver record. Optionally accepts documents for a one-shot
        onboarding when an admin already has them on hand: either an already-hosted
        URL (`aadharDocUrl`/`dlDocUrl`/`policeDocUrl`, e.g. from a prior `POST /uploads`
        call) or a direct multipart file (`aadharDoc`/`dlDoc`/`policeDoc`) that this
        endpoint uploads to blob storage itself — provide at most one of the two per
        document. Also accepts `dlExpiryDate`. None of this verifies anything: every
        status still defaults to `pending`. Verification is always a separate, explicit
        admin decision made via a subsequent `PATCH` (see `partial_update` below),
        whether the documents were attached here or later.'
      summary: Create a driver profile
      tags:
      - 'Admin: Drivers'
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/DriverCreate'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/DriverCreate'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/DriverCreate'
        required: true
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/DriverCreate'
          description: ''
  /api/v1/drivers/{id}:
    get:
      operationId: drivers_retrieve
      description: |-
        Scopes a ViewSet to the authenticated principal's company.

        Both AdminUser and ApiClient (see accounts.authentication) expose
        `.company`, so this works the same regardless of which one authenticated
        the request — no thread-locals, no default-manager magic.
      summary: Get a driver
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        description: A UUID string identifying this driver.
        required: true
      tags:
      - 'Admin: Drivers'
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Driver'
          description: ''
    patch:
      operationId: drivers_partial_update
      description: 'True partial update: only whichever fields are sent get changed,
        everything else on the driver record is left exactly as it was. Beyond the
        base profile fields, accepts any subset of `aadharDocUrl`/`aadharDoc`/`aadharStatus`/`aadharNote`,
        the same three for `dl` and `police`, plus `dlExpiryDate`/`dlAllowedCategories`
        — this one endpoint now covers what used to be three separate `kyc/{docType}`
        endpoints. `*Doc` is a direct multipart file upload (mutually exclusive with
        the matching `*DocUrl`); providing either with no status resets that document
        to `pending` review; a `*Note` is required when rejecting; verifying the DL
        needs `dlExpiryDate`/`dlAllowedCategories` either in this request or already
        on file.'
      summary: Update a driver, including KYC
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        description: A UUID string identifying this driver.
        required: true
      tags:
      - 'Admin: Drivers'
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedDriverUpdate'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedDriverUpdate'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedDriverUpdate'
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/DriverUpdate'
          description: ''
    delete:
      operationId: drivers_destroy
      description: Soft-deletes and deactivates the driver — same effect as the `disable`
        action below, including the 409 `DRIVER_HAS_ACTIVE_TRIP` refusal. A raw hard
        delete is never performed via the API.
      summary: Delete a driver
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        description: A UUID string identifying this driver.
        required: true
      tags:
      - 'Admin: Drivers'
      responses:
        '204':
          description: No response body
  /api/v1/drivers/{id}/disable:
    post:
      operationId: drivers_disable_create
      description: Soft-deletes and deactivates a driver. Refuses with 409 `DRIVER_HAS_ACTIVE_TRIP`
        if they currently have a trip in progress.
      summary: Disable a driver
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        description: A UUID string identifying this driver.
        required: true
      tags:
      - 'Admin: Drivers'
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Driver'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Driver'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Driver'
        required: true
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Driver'
          description: ''
  /api/v1/drivers/{id}/kyc:
    get:
      operationId: drivers_kyc_retrieve
      description: Returns the Aadhar, driving-licence, and police-verification status/documents
        for one driver.
      summary: Get a driver's KYC status
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - 'Admin: Driver KYC'
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/DriverKyc'
          description: ''
  /api/v1/drivers/{id}/safety-score:
    get:
      operationId: drivers_safety_score_retrieve
      description: 'A 0-100 at-a-glance quality signal for one driver: 100 minus 3
        per unacknowledged tracking anomaly alert, 5 per unresolved trip issue, and
        10 per traffic-penalty issue raised in the window (floored at 0). Defaults
        to the start of the current week; override with `?since=` (an ISO date or
        datetime).'
      summary: Get a driver's safety score
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - 'Admin: Dashboard'
      responses:
        '200':
          description: No response body
  /api/v1/issues:
    get:
      operationId: issues_list
      description: Company-wide list of flagged trip issues — includes both manually-raised
        ones and the ones auto-created when a trip is cancelled with picked-up, undelivered
        goods.
      summary: List issues
      parameters:
      - in: query
        name: created_after
        schema:
          type: string
          format: date
      - in: query
        name: created_before
        schema:
          type: string
          format: date
      - in: query
        name: issue_type
        schema:
          type: string
          enum:
          - pickup
          - traffic_penalty
          - transit
          - unloading
        description: |-
          * `pickup` - Pickup
          * `transit` - Transit
          * `unloading` - Unloading
          * `traffic_penalty` - Traffic Penalty
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - in: query
        name: severity
        schema:
          type: string
          enum:
          - high
          - low
          - medium
        description: |-
          * `low` - Low
          * `medium` - Medium
          * `high` - High
      - in: query
        name: status
        schema:
          type: string
          enum:
          - open
          - resolved
        description: |-
          * `open` - Open
          * `resolved` - Resolved
      tags:
      - 'Admin: Issues'
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedIssueListList'
          description: ''
  /api/v1/issues/{id}:
    get:
      operationId: issues_retrieve
      description: |-
        Scopes a ViewSet to the authenticated principal's company.

        Both AdminUser and ApiClient (see accounts.authentication) expose
        `.company`, so this works the same regardless of which one authenticated
        the request — no thread-locals, no default-manager magic.
      summary: Get an issue
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        description: A UUID string identifying this trip issue.
        required: true
      tags:
      - 'Admin: Issues'
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/IssueDetail'
          description: ''
  /api/v1/issues/{id}/mark-penalty-paid:
    post:
      operationId: issues_mark_penalty_paid_create
      description: 'Admin-only: records that a traffic_penalty issue''s fine has been
        paid/reimbursed. 409 if the issue isn''t a traffic_penalty, or is already
        marked paid.'
      summary: Mark a traffic penalty paid
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        description: A UUID string identifying this trip issue.
        required: true
      tags:
      - 'Admin: Issues'
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/IssueDetail'
          description: ''
  /api/v1/issues/{id}/resolve:
    post:
      operationId: issues_resolve_create
      description: 'Admin-only: marks a flagged issue resolved.'
      summary: Resolve an issue
