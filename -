openapi: 3.0.3
info:
  title: MOB Delivery Backend API
  version: 1.0.0
  description: Multi-tenant delivery platform API — Company/AdminUser/ApiClient auth,
    Vehicle module.
paths:
  /api/v1/admin/users:
    get:
      operationId: admin_users_list
      description: |-
        GET/POST /api/v1/admin/users — Fix 8, sub-user management. Every
        sub-user gets the same full access within their company — no roles/
        permissions tiers in this pass.
      parameters:
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      tags:
      - admin
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedAdminUserList'
          description: ''
    post:
      operationId: admin_users_create
      description: |-
        GET/POST /api/v1/admin/users — Fix 8, sub-user management. Every
        sub-user gets the same full access within their company — no roles/
        permissions tiers in this pass.
      tags:
      - admin
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AdminUser'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AdminUser'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AdminUser'
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AdminUser'
          description: ''
  /api/v1/admin/users/{id}/disable:
    post:
      operationId: admin_users_disable_create
      description: POST /api/v1/admin/users/{id}/disable
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - admin
      responses:
        '200':
          description: No response body
  /api/v1/alerts:
    get:
      operationId: alerts_list
      description: |-
        Scopes a ViewSet to the authenticated principal's company.

        Both AdminUser and ApiClient (see accounts.authentication) expose
        `.company`, so this works the same regardless of which one authenticated
        the request — no thread-locals, no default-manager magic.
      parameters:
      - in: query
        name: acknowledged
        schema:
          type: boolean
      - in: query
        name: alert_type
        schema:
          type: string
          enum:
          - stationary_too_long
          - wrong_direction
        description: |-
          * `stationary_too_long` - Stationary Too Long
          * `wrong_direction` - Wrong Direction
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      tags:
      - alerts
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedTripAnomalyAlertList'
          description: ''
