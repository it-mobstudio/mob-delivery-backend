        id:
          type: string
          format: uuid
          readOnly: true
        full_name:
          type: string
          maxLength: 150
        phone_number:
          type: string
          maxLength: 20
        emergency_contact_name:
          type: string
          maxLength: 150
        emergency_contact_phone:
          type: string
          maxLength: 20
