          description: ''
  /api/v1/auth/refresh:
    post:
      operationId: auth_refresh_create
      description: |-
        POST /api/v1/auth/refresh — body { refreshToken } -> a new accessToken.
        Shared by every principal type (Admin, Driver) — see RefreshTokenSerializer.
      tags:
      - auth
      security:
      - {}
      responses:
        '200':
