  /api/v1/trips/assignment-candidates:
    post:
      operationId: trips_assignment_candidates_create
      description: 'Returns `matches`: vehicles that are either free right now or
        expected to finish their current trip within `within_minutes` (active status,
        sufficient capacity), paired with drivers eligible to drive them (fully verified,
        active, DL not expired, and whose `dl_allowed_categories` include the vehicle''s
        category). Each match''s `availableInMinutes` is `0` for a vehicle that''s
        free now, or the estimated minutes until it will be — a straight-line/assumed-speed
        estimate from the vehicle''s last location ping through its remaining stops,
        not a routed one. A busy vehicle whose trip hasn''t started moving yet, or
        has no recent location ping, is excluded rather than guessed at. Also returns
        `excludedVehicles`: otherwise-assignable vehicles with zero eligible drivers,
        each with a human-readable `reason`, so the Admin Panel can show them disabled
        instead of just missing from the list. Accepts either `trip_id` or `order_refs`
        to determine the required weight capacity.'
      summary: Find vehicle/driver candidates for assignment
      tags:
      - 'Admin: Trips'
      - 'Integrations: Orders'
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AssignmentCandidatesRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AssignmentCandidatesRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AssignmentCandidatesRequest'
      responses:
